# =============================================================================
# Demo branch — no database and no third-party services.
# The app serves the built-in Northgate sample store from memory (lib/demo).
# For the real app (MongoDB, Stripe, email, …) see .env.example on `main`.
# =============================================================================

# Secret used to sign the demo session cookie. Use a long random string.
JWT_SECRET="replace-with-a-long-random-string"

# Public URL of the demo. netlify.toml sets these for the hosted site.
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
